{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rag-slides-demo",
	"main": "src/app.ts",
	"compatibility_date": "2026-09-01",
	"preview_urls": false,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"secrets": {
		"required": [
			"OPENROUTER_API_KEY",
			"OPENROUTER_EMBEDDING_MODEL",
			"OPENROUTER_CHAT_MODEL",
			"APP_USERNAME",
			"APP_PASSWORD"
		]
	},
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "rag-slides-index",
			"remote": true
		}
	],
	"observability": {
		"enabled": true,
		"redact_query_string": false
	},
}
